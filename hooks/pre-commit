#!/usr/bin/env bash
# Course-change gate.
#
# Activate with:  git config core.hooksPath hooks
# Git cannot version that setting, so it is one command per clone. This file is
# versioned, so re-activation is a command and not a rewrite.
#
# What it does: refuses a commit that changes, DELETES or RENAMES a DEC entry
# or the reference register without a matching entry in the private research
# repository's HISTORY.md. See AGENTS.md, GROUNDING & TRACEABILITY.
#
# DEGRADES TO A NO-OP for anyone who does not have that repository, so an
# outside contributor is never blocked by it. That is the normal case for
# everyone but the author.
#
# --no-verify bypasses this, as it does every git hook. That is git.
#
# BUG HISTORY, so the same mistakes are not reintroduced:
#   a. --diff-filter=ACMR omitted D, so deleting docs/references.md entirely
#      bypassed the gate. The maximal course change was the one it could not
#      see. Separately, rename DETECTION reported only the destination path,
#      so `git mv docs/references.md docs/refs2.md` was invisible too;
#      --no-renames now decomposes a rename into a delete plus an add.
#   b. `tail -n 80 HISTORY.md | grep` windowed the search, so a single entry
#      longer than 80 lines would push its own heading out of view and refuse
#      a legitimate commit. The whole file is scanned now; it is small.
set -uo pipefail

# Explicit opt-out for a change that is genuinely not a course change.
[ "${TERE4AI_NO_HISTORY:-0}" = "1" ] && exit 0

# Include D and R: a deletion or a rename is a course change, not an exemption.
staged=()
while IFS= read -r -d '' f; do
  staged+=("$f")
done < <(git diff --cached --name-only -z --no-renames --diff-filter=ACMD)

has_path() {
  local needle=$1 item
  for item in ${staged+"${staged[@]}"}; do
    [ "$item" = "$needle" ] && return 0
  done
  return 1
}

trigger=""

# Inside architecture.md only a DEC line counts. A typo fix is not a course
# change, and a gate that fires on typos gets bypassed and then ignored.
# A deletion of the file counts unconditionally.
if has_path docs/architecture.md; then
  if [ ! -f docs/architecture.md ]; then
    trigger="the deletion of docs/architecture.md"
  elif git diff --cached -U0 --diff-filter=ACMRD -- docs/architecture.md \
       | grep -E '^[+-]' | grep -v '^+++ ' | grep -v '^--- ' \
       | grep -q 'DEC-[0-9]'; then
    trigger="a DEC entry in docs/architecture.md"
  fi
fi

# The reference register is a live lint target: any change to it counts, and so
# does removing it.
if has_path docs/references.md; then
  if [ ! -f docs/references.md ]; then
    trigger="${trigger:+$trigger and }the deletion of the reference register"
  else
    trigger="${trigger:+$trigger and }the reference register"
  fi
fi

[ -z "$trigger" ] && exit 0

root=$(git rev-parse --show-toplevel)
thesis=${TERE4AI_THESIS_DIR:-$(dirname "$root")/thesis}

if [ ! -d "$thesis/.git" ] || [ ! -f "$thesis/HISTORY.md" ]; then
  echo "note: no research repository at $thesis, course-change gate skipped" >&2
  exit 0
fi

today=$(date +%Y-%m-%d)

# Pass if today already has an entry, or if HISTORY.md is being edited right now
# (staged or unstaged), which is the normal flow: write the entry, then commit.
# Scan the WHOLE file; see bug (b).
grep -q "^## $today" "$thesis/HISTORY.md" && exit 0
git -C "$thesis" diff        --quiet -- HISTORY.md || exit 0
git -C "$thesis" diff --cached --quiet -- HISTORY.md || exit 0

cat >&2 <<EOF
REFUSED: this commit changes $trigger, and
  $thesis/HISTORY.md
has no entry dated $today and no pending change.

A course change is recorded before it ships. Add an entry:

  ## $today  <short title>

  - changed: what is now in force, stated positively.
  - why: the evidence that forced it. Never invent one.
  - replaced: what was believed or done before, and until when.

If this genuinely is not a course change (a typo, a reformat, a regenerated
line), say so explicitly:

  TERE4AI_NO_HISTORY=1 git commit ...
EOF
exit 1
