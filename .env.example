# TERE4AI v2 environment (copy to .env; .env is never committed)

# Neo4j password for docker compose (optional here: docker-compose.yml
# falls back to a compose-level dev default, tere4ai2_dev, if unset. Set a
# real value in .env for anything beyond a loopback-bound local dev setup.
NEO4J_PASSWORD=change_me
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j

# Runtime internal models (architecture.md Section 7; config values, never hardcoded)
# Generator (extraction, alignment, runtime generation): OpenAI
OPENAI_API_KEY=
TERE4AI_GENERATOR_MODEL=gpt-5.2
# Judges (extraction, mapping, runtime grounding): independent non-OpenAI family
# (DEC-07, decided 2026-07-08)
ANTHROPIC_API_KEY=
TERE4AI_JUDGE_MODEL=claude-opus-4-8
