# TERE4AI v2 environment (copy to .env; .env is never committed)

# Neo4j password for docker compose (optional here: docker-compose.yml
# falls back to a compose-level dev default, tere4ai2_dev, if unset. Set a
# real value in .env for anything beyond a loopback-bound local dev setup.
NEO4J_PASSWORD=change_me
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j

# Runtime internal models (architecture.md Section 7; config values, never hardcoded)
# Generator (extraction, alignment, runtime generation): OpenAI
OPENAI_API_KEY=
TERE4AI_GENERATOR_MODEL=gpt-6-astra
# Judges (extraction, mapping, runtime grounding): independent non-OpenAI family
# (DEC-07, decided 2026-07-08)
ANTHROPIC_API_KEY=
TERE4AI_JUDGE_MODEL=claude-opus-5-5
# Temperature, effort and JSON mode are declared per model in
# config/model_parameters.json (spec F D-F29), never here: the table is keyed
# by the model ids above and selects nothing. TERE4AI_GENERATOR_EFFORT and
# TERE4AI_JUDGE_EFFORT are no longer read, and a run refuses to start while
# either is set.
# DEC-24 (spec G D-G74): the HTTP facade's demo judge, an OpenAI model in the
# judge's role for the dashboard's judge routes only (never TERE4AI_JUDGE_MODEL,
# never the generator's model); it needs rows in config/model_parameters.json
# and config/model_prices.json. The MCP tools and the inline routes keep
# DEC-07's judge above.
TERE4AI_DEMO_JUDGE_MODEL=gpt-6-sol
# The key the facade signs generator-only answers with: 64 hexadecimal
# characters (32 bytes), held by the facade alone, e.g. the output of
# python -c "import secrets; print(secrets.token_hex(32))". Changing it leaves
# earlier answers unjudgeable.
TERE4AI_ANSWER_SIGNING_KEY=
