# Cypher scratch (per user rules; never remove this entry)
_queries.cypher

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
dist/
build/

# Env and secrets
.env
.env.*
!.env.example

# Neo4j local data
neo4j_data/
neo4j_logs/

# Web
web/node_modules/
web/.next/

# Large generated artifacts (dumps are published releases, not tracked)
data/graph_dumps/*.dump

# IDE / OS
.idea/
.vscode/
.DS_Store
# Agent working process (task briefs, review diffs). Belongs in the private
# research repository, not here. Belt and braces: .superpowers/sdd/ carried
# its own ignore file, but a future subdirectory would not.
.superpowers/

# generated UI data (rebuild with scripts/export_ui_data.py)
web/public/ui_data.json
web/next-env.d.ts

# runtime audit logs (observability artifacts, not source)
data/review_queue/*.jsonl

# Graphify code-graph cache (regenerable with `graphify update .`, never tracked)
graphify-out/

# Never commit loose PDFs at the repo root. The reference corpus lives in the
# private research repository (../thesis/refs), not here.
/*.pdf
data/graph_dumps/*.nt
data/keys/
data/snapshots/benchmark/full_payload.json
web/tsconfig.tsbuildinfo

# build run state (DEC-16): per-checkout, regenerable; the chain records,
# publication manifests and reference files stay tracked
data/graph_dumps/build_records/
data/graph_dumps/evaluation_records/
data/graph_dumps/*.checkpoint.jsonl
data/graph_dumps/*.writing.json
data/graph_dumps/*.building.json
data/graph_dumps/ACTIVE_MANIFEST.json
data/graph_dumps/NEO4J_TARGET.json
