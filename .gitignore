# Cypher scratch (per user rules; never remove this entry)
_queries.cypher

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
dist/
build/

# Env and secrets
.env
.env.*
!.env.example

# Neo4j local data
neo4j_data/
neo4j_logs/

# Web
web/node_modules/
web/.next/

# Large generated artifacts (dumps are published releases, not tracked)
data/graph_dumps/*.json
data/graph_dumps/*.dump

# IDE / OS
.idea/
.vscode/
.DS_Store

# generated UI data (rebuild with scripts/export_ui_data.py)
web/public/ui_data.json
web/next-env.d.ts

# runtime audit logs (observability artifacts, not source)
data/review_queue/*.jsonl

# Reference papers (full text): local only, do not commit (paywalled / licensing).
data/refs/*.pdf
data/refs/*.html
data/refs/*.txt
data/refs/graphify-out/
# Graphify code-graph cache (regenerable with `graphify update .`, never tracked)
graphify-out/

# Never commit loose PDFs at the repo root (paper copies belong in data/refs, gitignored).
/*.pdf
data/graph_dumps/*.nt
data/keys/
data/snapshots/benchmark/full_payload.json
docs/live_audit_log.md
