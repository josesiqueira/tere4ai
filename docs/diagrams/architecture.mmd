%% TERE4AI v2 architecture, mermaid edition (2026-09-17; first edition 2026-07-20).
%% Editable companion to tere4ai_v2_architecture_2026-09-17.svg (the polished paper
%% figure generated by scripts/make_architecture_diagram.py). Same verified
%% content; guard-tested against the same decided facts. Open in draw.io via
%% the drawio MCP tool open_drawio_mermaid, or any mermaid renderer.
%% Formatting rule: no em or en dashes anywhere in this file.

flowchart TB

subgraph CONSUMERS["CONSUMERS"]
  CA["Coding Agent<br/>Claude Code, Cursor, ...<br/>speaks MCP, reads SKILL.md<br/>discovery: /llms.txt, /.well-known"]
  HB["Human (Browser): tere4ai-dashboard<br/>Build: the graph as a wizard, live progress, layer closing<br/>Evaluate: calibration campaigns, judge runs, specialists<br/>Use: projects, classification, requirements, backlog, traces (the product)<br/>Research (owner only): lineage across phases, numbers, verdicts, exports"]
  P2C["Phase 2+ consumers<br/>remote agents, REST clients<br/>added with the hosted SaaS"]
end

subgraph PHASE1["PHASE 1 RUNTIME (docker compose up). SELF-HOSTED: everything in this frame runs on the user's machine; the graph and project evidence never leave it in self-hosted mode"]
  MCP["TERE4AI MCP Server<br/>Python, FastMCP; stdio or HTTP+keys<br/>8 Section 8 tools + resolve_span + batch evidence<br/>free tools are deterministic, paid tools marked"]
  SVC["Domain / Service Layer<br/>risk classification: deterministic rule ladder,<br/>the LLM never decides the tier (DEC-13)<br/>requirements generation with span citations<br/>runtime grounding judge on every paid answer<br/>calibrated status vocabulary (never 'compliant')"]
  KG["Knowledge graph artifacts<br/>versioned JSON dumps + frozen snapshots,<br/>every file sha256-checksummed (build chain)<br/>full Act mirror; judged norms; reified HLEG alignments;<br/>provenance on every edge<br/>served build id = snapshot hash + chain over the exact dump files served (B74)<br/>runtime needs NO live database<br/>Neo4j optional: browsing + n10s RDF export"]
end

LOCAL["Local model (Tier 3)<br/>experimental: fully on-machine, lower quality<br/>ON-MACHINE (sovereign)"]
APIS["Model APIs (runtime internals)<br/>generator: OpenAI gpt-6-astra (extraction, alignment, answers)<br/>judges: Anthropic Claude claude-opus-5, an independent model<br/>family with uncorrelated failure modes (DEC-07); ids since 2026-09-16 (B74)<br/>temperature 0 requested, provider default where rejected, recorded per build<br/>config from .env, never hardcoded; degraded envelope if absent<br/>THESE CALLS LEAVE THE MACHINE"]

subgraph BUILD["BUILD TIME (offline), producing the knowledge graph. Full structural mirror; deep extraction only on the high-risk core. The v1 poster query is kept as a regression fixture over the regenerated graph."]
  direction LR
  SRC["EU AI Act + HLEG<br/>OJ text via CELLAR / ELI<br/>frozen + checksummed"]
  PARSE["Deterministic parse<br/>structure from frozen HTML + Formex;<br/>node IDs derived from parsed structure, no LLM;<br/>cross-refs by rule first"]
  EXTRACT["LLM extraction<br/>deontic norms + HLEG alignments<br/>(OpenAI generator, judged next)"]
  JUDGES["JUDGES<br/>extraction + mapping judges<br/>(Anthropic Claude, DEC-07)<br/>accept / reject / review"]
  QUEUE["Human review queue<br/>today: needs_human_review items via scripts/review_cli.py (accept / reject);<br/>rejected candidates are dropped; never served as accepted<br/>direction (2026-09-17): every core source unit reviewable in the dashboard Build view<br/>with accept, reject, correct and add, plus a blind subset for recall"]
  NEO["Neo4j KG + gates<br/>validation gates G1-G6;<br/>a failing build is not published"]
  DUMPS["Versioned dumps<br/>published JSON artifacts,<br/>sha256 build chain;<br/>what the runtime serves"]
  SRC --> PARSE --> EXTRACT --> JUDGES --> QUEUE --> NEO --> DUMPS
end

subgraph EVALUATE["EVALUATE (measuring the tool; separate diagram to follow)"]
  direction LR
  GRADE["Specialist grading<br/>dashboard campaigns, personal links;<br/>HLEG alignments: correct / incorrect / cannot decide;<br/>tailored requirements: 1 to 5 rubric;<br/>Layer 2 blind subset for recall"]
  CALIB["Judge calibration (B68)<br/>eight candidate models grade the same items;<br/>EMD with permutation null, weighted kappa,<br/>inter-specialist ceiling; Python cross-check"]
  ERR["Judge error rates (H1)<br/>50 blind-labelled judge decisions;<br/>false accept, false reject"]
  BENCH["Benchmark and ablations<br/>REF-15 AI Act Evaluation Benchmark;<br/>ladder: plain LLM, RAG, graph,<br/>graph + build judge, graph + runtime judge"]
end

subgraph PHASE2["PHASE 2+ (later): MULTI-TENANT HOSTED SaaS on Rahti (CSC, EU), same service layer and graph. Only transport, auth, and tenancy change; core code stays identical."]
  direction LR
  REST["REST API<br/>API keys, rate limits"]
  RMCP["Remote MCP<br/>streamable HTTP, OAuth"]
  MT["Multi-tenant<br/>usage metering, billing"]
  FUI["Full Web UI<br/>accounts, dashboards"]
end

CA -->|"MCP (stdio / localhost)"| MCP
HB -->|"HTTP facade"| SVC
MCP --> SVC
SVC --> KG
SVC -.->|"Tier 3 option"| LOCAL
SVC -->|"generator + judge calls"| APIS
DUMPS --> KG
DUMPS -->|"build artefacts + runtime envelopes feed Evaluate"| GRADE
GRADE -.->|"decisions, once closing rules are set"| QUEUE

