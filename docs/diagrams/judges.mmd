%% TERE4AI v2 LLM-as-judge, mermaid edition (2026-07-20).
%% Editable companion to judge_diagram.svg (generated by
%% scripts/make_judge_diagram.py); same content verified by the 2026-07-19/20
%% judge audits. Three separate judges (Anthropic Claude) gate the OpenAI
%% generator. Mechanical, non-LLM checks run before and after every judge.
%% No numeric thresholds: the categorical verdict decides; the five scores
%% are recorded evidence.
%% An unusable judge response can never accept anything.
%% .
%% The five recorded scores (defined in the judge prompts, clamped to 0,1,
%% never thresholded): semantic_similarity, normative_relevance,
%% operational_utility, evidence_strength (surfaced as envelope confidence,
%% uncalibrated until task 25), judge_confidence. The categorical verdict
%% (accepted / rejected / needs_human_review) is the only thing that gates;
%% fallback on unusable output is needs_human_review with all scores zeroed.
%% .
%% Change detection: every event and JudgeRun logs the prompt's sha256, so
%% editing a prompt file is detectable even at the same version label and
%% tied to the decisions it made. Independence: the config loader rejects an
%% OpenAI-family judge or one equal to the generator; the same client object
%% as both generator and judge is refused at use time; temperature 0.
%% Honest limits, stated: judge FA/FR rates are instrumented but unmeasured
%% until the 50-decision human labeling (task 25 / TASKS.md H1).
%% .
%% Inspect the values yourself (braces and pipes omitted here because
%% mermaid parses them even inside comments; full copyable commands live in
%% judge_diagram.svg and scripts/make_judge_diagram.py):
%%   jq .judge_runs0 data/graph_dumps/norms_core.json
%%   jq over .norms selecting review_status accepted, count .judge_verdict
%%   tail -3 data/review_queue/runtime_log.jsonl
%%   .venv/bin/python scripts/consolidated_audit.py
%%   POST /api/explain with norm_id norm:eu-ai-act:article-9:paragraph-1:n1

flowchart TB

subgraph LANE1["BUILD TIME 1: NORM EXTRACTION (extract_norms/pipeline.py)"]
  direction LR
  SU["Source unit<br/>one article / paragraph / point<br/>with verbatim text + span id;<br/>recitals refused as sources (raises)"]
  GEN1["Generator (OpenAI)<br/>proposes candidate norms as JSON,<br/>temperature 0, one retry on parse failure"]
  MECH1["Mechanical pre-checks<br/>field allow-list (11 schema fields);<br/>candidates without a source span<br/>skipped before any judging"]
  EJ["Extraction judge<br/>prompts/judge_norms/v1.md<br/>6 checks: span exists, deontic supported,<br/>actor valid, grounded, conditions kept,<br/>binding source only"]
  SU --> GEN1 --> MECH1 --> EJ
end

PUB["Published norm<br/>provenance LLM_JUDGED_ACCEPTED;<br/>schema-validated or dropped<br/>with the JudgeRun kept"]
EXC["Excluded from the graph<br/>JudgeRun kept for audit;<br/>never served, never aligned"]
HRQ1["Human review queue<br/>adjudicated via scripts/review_cli.py;<br/>decisions republished with<br/>HUMAN_REVIEWED provenance"]

EJ -->|accepted| PUB
EJ -->|rejected| EXC
EJ -->|"needs review / unusable output"| HRQ1

subgraph LANE2["BUILD TIME 2: HLEG ETHICS ALIGNMENT (align_hleg_altai/pipeline.py)"]
  direction LR
  AN["Accepted norm<br/>only judge-accepted norms are ever aligned<br/>+ one of the 7 closed HLEG requirements"]
  GEN2["Generator (OpenAI)<br/>proposes up to 3 candidate alignments,<br/>each with a source quote AND a target quote<br/>(evidence both sides)"]
  MECH2["Mechanical quote gate<br/>each quote must be a verbatim substring<br/>of its side's text; failures NEVER reach<br/>the judge (logged as mechanical:quote_check)"]
  MJ["Mapping judge<br/>prompts/judge_alignment/v1.md<br/>4 checks; may CORRECT the relation type<br/>(closed set); no forced mapping"]
  AN --> GEN2 --> MECH2 --> MJ
end

RAA["Reified AlignmentAssertion<br/>never a bare truth edge; gate G4 fails any<br/>accepted assertion missing evidence spans<br/>on both sides; served with the<br/>not-expert-validated caveat"]
HELD["Held, never served as accepted<br/>145 pending assertions live<br/>in the review queue today"]

MJ -->|accepted| RAA
MJ -->|"rejected / review"| HELD

subgraph LANE3["RUNTIME: EVIDENCE EVALUATION AND BACKLOG, PAID PATHS (mcp_server/evidence.py, backlog.py)"]
  direction LR
  PA["Project artifact<br/>UNTRUSTED text, fenced as<br/>data-never-instructions;<br/>refusal gate: a non-accepted norm is<br/>refused BEFORE any model call"]
  GEN3["Generator (OpenAI)<br/>assessment with quotes, gaps, rationale;<br/>backlog items citing norm ids;<br/>sees the norm's verbatim legal source text"]
  MECH3["Mechanical checks<br/>quotes: verbatim substring or dropped;<br/>zero surviving quotes downgrades to<br/>cannot_assess; backlog citation allow-list:<br/>unknown norm ids dropped"]
  RJ["Runtime grounding judge<br/>prompts/runtime_grounding/v1.md<br/>7 checks: citations support claim, closed<br/>citation set, sources kept apart, uncertainty<br/>marked, no compliance claim, injection detected;<br/>digest includes the norm's verbatim source text"]
  PA --> GEN3 --> MECH3 --> RJ
end

ANS["Answer surfaces<br/>envelope judge_verdict: accepted;<br/>confidence = the judge's own evidence_strength<br/>score (uncalibrated until task 25)"]
DEG["Degraded, never silent<br/>status forced to requires_human_review,<br/>confidence 0.0, judge rationale attached;<br/>pipeline stops earlier: verdict not_run"]

RJ -->|accepted| ANS
RJ -->|"any other verdict"| DEG

subgraph VALUES["WHERE EVERY JUDGE VALUE LIVES (nothing hidden; build values static per build, runtime values per call)"]
  direction LR
  JR["JudgeRun records (static per build)<br/>inside norms_core.json and alignments_core.json:<br/>verdict, rationale, all 5 scores, judge model,<br/>prompt version AND prompt sha256, timestamps;<br/>442 extraction + 636 alignment runs this build;<br/>regenerated only by a new judged build<br/>or a human adjudication"]
  LOGS["Append-only audit logs (JSONL)<br/>data/review_queue/extraction_log.jsonl,<br/>alignment_log.jsonl, runtime_log.jsonl:<br/>one event per call with model, prompt version +<br/>sha256, verdict, rationale, input sha256<br/>(text never logged; secrets scrubbed);<br/>merge with scripts/consolidated_audit.py"]
  ENV["The envelope (per call, dynamic)<br/>every runtime answer carries judge_verdict,<br/>judge_rationale (in answer), confidence,<br/>and judge_run_id; two identical paid calls<br/>may differ (model nondeterminism), which is<br/>why the verdict gates and the scores<br/>only describe"]
end

PUB -.-> JR
RAA -.-> JR
ANS -.-> ENV
EJ -.-> LOGS
MJ -.-> LOGS
RJ -.-> LOGS

classDef src stroke:#6e7681,fill:#11151c,color:#9aa4ad
classDef gen stroke:#e3b341,fill:#1d1704,color:#e6edf3
classDef mech stroke:#9aa4ad,fill:#141920,color:#e6edf3
classDef judge stroke:#a371f7,fill:#191426,color:#e6edf3
classDef ok stroke:#3fb950,fill:#0c1a10,color:#e6edf3
classDef bad stroke:#f85149,fill:#1a0c0c,color:#e6edf3
classDef human stroke:#d2649a,fill:#231018,color:#e6edf3
class SU,AN,PA src
class GEN1,GEN2,GEN3,ENV gen
class MECH1,MECH2,MECH3,LOGS mech
class EJ,MJ,RJ,JR judge
class PUB,RAA,ANS ok
class EXC,DEG bad
class HRQ1,HELD human
